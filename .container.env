PODMAN_HOST=unix:///run/user/1000/podman/podman.sock
NOYRA_CONFIG=/config/config.cue
ETCD_CA_CERT=/certs/ca.pem
ETCD_CA_KEY=/certs/ca-key.pem
ETCD_SERVER_CERT=/certs/etcd-server.pem
ETCD_SERVER_KEY=/certs/etcd-server-key.pem
ETCD_CLIENT_CERT=/certs/etcd-client.pem
ETCD_CLIENT_KEY=/certs/etcd-client-key.pem
